{
    "name": "cobalt-to-workers",
    "packageManager": "pnpm@9.6.0",
    "engines": {
        "pnpm": ">=9"
    },
    "scripts": {
        "test:workers": "node --test api/worker/test/worker.test.js",
        "workers:api:dev": "wrangler dev --config api/wrangler.jsonc",
